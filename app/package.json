{
  "name": "obsidian-knowledge-base",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "个人考研知识库 · Vite + Node，可打包为 Windows 桌面程序",
  "repository": "github:yixiongfei/My-obsidian",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env PORT=5174 node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.1",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "node-html-parser": "^9.0.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.6.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.18.2",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "seek-bzip": "^2.0.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.yixiongfei.knowledgebase",
    "productName": "知识库",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "dist-web/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "kb-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "知识库"
    }
  }
}
